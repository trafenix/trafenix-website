# ============================================================
# TRAFENIX WEBSITE EMAIL CONFIGURATION
# ============================================================

# Target inbox for incoming enquiries (default is info@trafenix.com)
CONTACT_EMAIL=info@trafenix.com

# ------------------------------------------------------------
# OPTION 1: Web3Forms (Recommended - Free & 2 min setup)
# 1. Visit https://web3forms.com and enter info@trafenix.com
# 2. Check your inbox for the Access Key
# 3. Paste the Access Key below:
# ------------------------------------------------------------
WEB3FORMS_ACCESS_KEY=

# ------------------------------------------------------------
# OPTION 2: Resend (Alternative API provider)
# 1. Sign up at https://resend.com
# 2. Get your API Key from API Keys dashboard
# 3. Paste the API key below:
# ------------------------------------------------------------
RESEND_API_KEY=
